# =============================================================================
# Mello – environment proměnné (zkopírujte do .env pro lokální vývoj)
# =============================================================================

# Supabase – Project Settings → API
VITE_SUPABASE_URL=https://VASE-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Frontend API (volitelné, jen lokálně)
# Prázdné = /api/chat přes Vite proxy → localhost:5000 (npm run dev + server)
# Na Netlify NENASTAVUJTE VITE_API_URL – chat jde na Netlify Function /api/chat
# VITE_API_URL=http://127.0.0.1:5001

# =============================================================================
# Netlify PRODUKCE – povinné pro chat (nikdy do frontendu, necommitovat)
# =============================================================================
# V Netlify UI nastavte:
#   Site configuration → Environment variables → Add variable
#   Key:   OPENAI_API_KEY
#   Value: váš OpenAI klíč (stejný jako ve server/.env)
#   Scopes: Production (a případně Deploy previews)
# Po uložení: Deploys → Trigger deploy → Redeploy
#
# Ověření po deployi:
#   curl https://VASE-DOMENA.netlify.app/api/chat
#   (GET → {"openaiConfigured":true})
#
# Lokální Express (server/.env) – jen pro npm start ve server/
